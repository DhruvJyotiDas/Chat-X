# ─────────────────────────────────────────────────────────────────────────────
# Frontend build-time configuration (Vite).
#
# Copy to `.env` (git-ignored) ONLY if you need to override a default. Every
# value below is optional: with an empty/absent .env the build derives all URLs
# from the browser's own origin at runtime (see src/config.ts), which is correct
# whenever the frontend is served from the same domain that reverse-proxies the
# Go backend (the normal single-host deployment).
#
# Set these only when the frontend is served from a DIFFERENT origin than the
# backend/identity provider. After changing, rebuild: `npm run build`.
# ─────────────────────────────────────────────────────────────────────────────

# REST API base path (or absolute URL if the backend is on another host).
# VITE_API_BASE=/api

# WebRTC signaling socket. Default: wss://<current-host>/ws
# VITE_WS_URL=wss://meet.example.com/ws

# Live-captions (ASR) relay socket. Default: wss://<current-host>/asr
# VITE_ASR_WS_URL=wss://meet.example.com/asr

# IB Account (OIDC identity provider).
# issuer default:      https://<current-host>/auth
# redirectUri default: https://<current-host>/    (MUST match the backend's
#                      IB_ACCOUNT_REDIRECT_URI exactly)
# VITE_IB_ACCOUNT_ISSUER=https://meet.example.com/auth
# VITE_IB_ACCOUNT_REDIRECT_URI=https://meet.example.com/
# VITE_IB_ACCOUNT_URL=https://meet.example.com/auth/account
# VITE_IB_ACCOUNT_CLIENT_ID=ibc_C_gqO2jdhASAN73QgLG0LXbDM4osR046

# ─────────────────────────────────────────────────────────────────────────────
# IB Account (OIDC identity provider) — runtime configuration.
#
# Template for the file the systemd unit loads:
#     EnvironmentFile=/etc/ib-account/env      (chmod 600, root-owned)
#
#   KEY=value      required
#   # KEY=value    optional — shown with its built-in default
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────
# Password is the only required value. User/addr default to IB Connect's, and
# IB_ACCOUNT_DB_PASSWORD falls back to IBCONNECT_DB_PASSWORD if unset — so a
# shared /etc/ib-account/env that also sources IB Connect's works with nothing
# but the schema grant.
IB_ACCOUNT_DB_PASSWORD=
# IB_ACCOUNT_DB_USER=ibconnect_app
# IB_ACCOUNT_DB_ADDR=127.0.0.1:3306
# IB_ACCOUNT_DB_NAME=ib_account

# ── OIDC issuer ──────────────────────────────────────────────────────────
# MUST be byte-identical to IB Connect's IB_ACCOUNT_ISSUER. It is the `iss`
# claim in every id_token and the base of the authorize / token / jwks URLs.
# IB_ACCOUNT_ISSUER=https://meet.icebrkr.space/auth
# IB_ACCOUNT_BASE_PATH=/auth
# IB_ACCOUNT_ADDR=127.0.0.1:8090

# ── The IB Connect OAuth client ────────────────────────────────────────
# Upserted into oauth_clients on every boot, so THIS pair and the same pair in
# /etc/ibconnect/env are the one source of truth. Generate the secret with:
#   openssl rand -hex 32
IB_ACCOUNT_CLIENT_ID=
IB_ACCOUNT_CLIENT_SECRET=
# Exact-match allow-list of redirect URIs (comma-separated). Must include IB
# Connect's IB_ACCOUNT_REDIRECT_URI verbatim.
# IB_ACCOUNT_REDIRECT_URIS=https://meet.icebrkr.space/

# ── Optional additional intranet SSO ────────────────────────────────────
# Existing IB Account login remains active when these are configured.
# UPSTREAM_OIDC_ISSUER=https://icebrkr.space
# UPSTREAM_OIDC_CLIENT_ID=ib-account
# UPSTREAM_OIDC_CLIENT_SECRET=
# UPSTREAM_OIDC_REDIRECT_URI=https://meet.icebrkr.space/auth/upstream/callback
# UPSTREAM_OIDC_ALLOWED_DOMAINS=icebrkr.one,icebrkr.space

# ── Signing key ────────────────────────────────────────────────────────
# RSA private key (PEM). Auto-generated 0600 on first boot if the path is
# empty. Relative paths resolve against the service WorkingDirectory.
# IB_ACCOUNT_KEY_FILE=data/oidc_signing_key.pem

# ── Email transport (transactional: OTP, welcome, reset, login alerts) ─
# Priority: EMAIL_API_KEY  →  SMTP_HOST  →  log mode (codes to the journal).
# Any send failure also falls back to logging the body, so a code is never lost.
#
# A) HTTPS API — the only option when the egress firewall allows just 443.
#    EMAIL_API is "brevo" (default) or "resend". The sender domain
#    (SMTP_FROM's address) must be verified with the provider (SPF/DKIM DNS).
# EMAIL_API=brevo
# EMAIL_API_KEY=
#
# B) Direct SMTP submission — needs outbound TCP 587 (or 465) open.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
#
# From: header / envelope sender, used by both transports.
# SMTP_FROM=IB Account <no-reply@icebrkr.space>

# ── Local dev only ────────────────────────────────────────────────────
# Serve Secure-less cookies so the flow works over plain http://localhost.
# IB_ACCOUNT_INSECURE_COOKIES=1

# Copy to the repository root as .env before running Docker Compose.
# Generate every secret independently, for example: openssl rand -hex 32
PUBLIC_ORIGIN=http://localhost:8088
# Host binding for the frontend gateway. Keep loopback when a TLS reverse proxy
# owns ports 80/443; use 0.0.0.0 only for intentional direct HTTP access.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8088
# Comma-separated browser origins allowed to call the API and open realtime sockets.
IBCONNECT_ALLOWED_ORIGINS=http://localhost:8088
LIVEKIT_PUBLIC_URL=ws://localhost:8088/livekit

APP_DB_PASSWORD=replace-with-a-long-random-value
APP_DB_ROOT_PASSWORD=replace-with-a-different-random-root-value
ACCOUNT_DB_PASSWORD=replace-with-a-different-long-random-value
ACCOUNT_DB_ROOT_PASSWORD=replace-with-another-random-root-value
IBCONNECT_JWT_SECRET=replace-with-at-least-32-random-characters
IB_ACCOUNT_CLIENT_ID=ibconnect-local
IB_ACCOUNT_CLIENT_SECRET=replace-with-a-long-random-client-secret
LIVEKIT_API_KEY=ibconnect-local-livekit
LIVEKIT_API_SECRET=replace-with-a-long-random-livekit-secret

# Optional external services. Features degrade honestly when unset.
AI_GPU_URL=
AI_GPU_TOKEN=
ASR_GPU_URL=
ASR_GPU_TOKEN=
ASR_GPU_PIN=
INTERVIEW_GPU_URL=
INTERVIEW_GPU_TOKEN=
GITHUB_TOKEN=

# Configure a real coturn deployment before enabling TURN in production.
TURN_HOST=localhost
TURN_STATIC_AUTH_SECRET=replace-with-a-random-turn-shared-secret

# Configure one production mail transport. With both blank, IB Account logs
# verification codes and must only be used for local development.
EMAIL_API=brevo
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IB Account <no-reply@localhost>

# Local HTTP needs non-Secure account cookies. Set this to 0 for every HTTPS
# deployment; secure cookies are the production default when it is omitted.
IB_ACCOUNT_INSECURE_COOKIES=1

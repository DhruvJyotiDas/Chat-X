# Rendered to /etc/ibconnect/livekit.yaml at deploy time (see README.md in
# this directory) — this template only ever holds placeholders. The real
# key/secret live in /etc/ibconnect/env, same convention as every other
# secret in this codebase; never commit the rendered file.
port: 7880
bind_addresses:
  # nginx terminates TLS on meet.icebrkr.space and reverse-proxies /livekit/
  # to this port — 7880 itself is never exposed directly to the internet,
  # same shape as /ws and /chat-ws already going through nginx to 8080.
  - "127.0.0.1"
rtc:
  # 20000/20001 chosen DELIBERATELY INSIDE coturn's own relay range
  # (/etc/turnserver.conf min-port=20000/max-port=60000) rather than outside
  # it — this host's firewall already has that whole range open both
  # tcp/udp for coturn, so LiveKit needs no new port opened at all. coturn's
  # allocator picks ports dynamically from that range and simply skips any
  # already in use; LiveKit binds these two once at startup and holds them
  # for the service's lifetime, so there's no runtime race, just one port
  # permanently removed from coturn's pool of ~40000 — negligible at this
  # host's scale.
  tcp_port: 20001
  udp_port: 20000
  use_external_ip: true
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
room:
  auto_create: true
  empty_timeout: 300
logging:
  level: info

# ─────────────────────────────────────────────────────────────────────────────
# Backend runtime configuration — the Go binary (server/).
#
# This is the template for the file the systemd unit loads:
#
#     EnvironmentFile=/etc/ibconnect/env      (chmod 600, root-owned)
#
# Copy it there, fill in the real secrets, and `systemctl restart
# ibconnect-backend`. Do NOT commit the filled-in file — every value here that
# looks like a secret is one. `git` ignores `.env*` except this example.
#
#   KEY=value            required — the backend refuses to start without it
#   # KEY=value          optional — shown commented with its built-in default
# ─────────────────────────────────────────────────────────────────────────────

# ── Required secrets (no default; startup aborts if unset) ───────────────────

# HS256 signing key for this app's own session JWTs. >= 32 chars. Rotating it
# logs every user out. Generate: openssl rand -base64 48
IBCONNECT_JWT_SECRET=
IBCONNECT_ALLOWED_ORIGINS=https://your-ib-connect.example

# MariaDB password for the application DB user.
IBCONNECT_DB_PASSWORD=

# ── Database (defaults match the original production box) ────────────────────
# IBCONNECT_DB_USER=ibconnect_app
# IBCONNECT_DB_ADDR=127.0.0.1:3306
# IBCONNECT_DB_NAME=lolafire_IBConnect

# ── HTTP listener ───────────────────────────────────────────────────────────
# Port the systemd unit / nginx upstream expects.
# PORT=8080
# Bind address. Keep loopback in production — nginx terminates TLS and proxies
# to 127.0.0.1:PORT. Set 0.0.0.0 only for isolated local testing.
# BIND_ADDR=127.0.0.1

# ── IB Account — OIDC identity provider ─────────────────────────────────────
# IB_ACCOUNT_ISSUER=https://meet.icebrkr.space/auth
# Optional private service URL used only for token/JWKS HTTP calls. Keep the
# public issuer above unchanged so ID-token validation remains correct.
# IB_ACCOUNT_INTERNAL_URL=http://ib-account.internal:8090/auth
# IB_ACCOUNT_REDIRECT_URI=https://meet.icebrkr.space/     # MUST match the
#                          frontend's VITE_IB_ACCOUNT_REDIRECT_URI exactly
IB_ACCOUNT_CLIENT_ID=
IB_ACCOUNT_CLIENT_SECRET=
# Domain for the synthesised fallback email when a user row must be created
# before the id_token's email claim is known.
# SSO_EMAIL_DOMAIN=sso.icebrkr.space

# ── TURN / coturn (WebRTC relay + pre-join connection test) ─────────────────
# TURN_HOST=meet.icebrkr.space
# Preferred: coturn `use-auth-secret` mode — the backend then hands out
# short-lived HMAC credentials. Must equal coturn's static-auth-secret.
TURN_STATIC_AUTH_SECRET=
# Legacy fallback, used only when TURN_STATIC_AUTH_SECRET is empty. Non-expiring.
# TURN_STATIC_USER=webrtc
# TURN_STATIC_PASS=webrtc123

# ── Rooms ──────────────────────────────────────────────────────────────────
# Max participants per room. 0 = unlimited (default). Mesh WebRTC realistically
# tops out around 6-8; the LiveKit SFU path can go higher (see deploy/livekit/).
# MAX_ROOM_SIZE=0

# ── LiveKit SFU (deploy/livekit/) ──────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVEKIT_URL=wss://meet.icebrkr.space/livekit

# ── Live-captions ASR GPU VM (gpu/ASR_CONTRACT.md) ─────────────────────────
# All unset => captions report "not_configured" and never open a mic.
ASR_GPU_URL=
ASR_GPU_TOKEN=
# SPKI SHA-256 cert pin for the GPU VM's self-signed TLS cert.
ASR_GPU_PIN=
# ASR_GPU_TIMEOUT=15s

# ── Virtual Interview GPU VM (gpu/CONTRACT.md) ─────────────────────────────
# Unset => /api/interview/status reports configured:false.
INTERVIEW_GPU_URL=
INTERVIEW_GPU_TOKEN=
# INTERVIEW_GPU_TIMEOUT=120s

# ── AI features (chat/reply/writing/memory/tasks — gpu/AI_CONTRACT.md) ────
# Unset => /api/ai/status reports configured:false. Point at
# gpu/mock_ai_server.py until the real service on 10.1.1.4 has a working
# /chat and a fixed /query — see AI_CONTRACT.md's header for why the real
# one isn't usable yet.
AI_GPU_URL=
AI_GPU_TOKEN=
# AI_GPU_TIMEOUT=60s

# ── Optional ──────────────────────────────────────────────────────────────
# Raises the GitHub API rate limit during CV/profile enrichment.
# GITHUB_TOKEN=

# Controlled web retrieval for Ask AIPA. Create a Brave Search API key and
# keep it server-side. Explicit/current-information queries use the fixed
# Brave endpoint; private-context questions are never sent there.
# BRAVE_SEARCH_API_KEY=
